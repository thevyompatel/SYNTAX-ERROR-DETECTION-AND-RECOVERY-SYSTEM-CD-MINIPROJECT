// Common mistakes in conditions -> Error productions
int main() {
    int x = 5;
    int y = 0;
    if x > 3 {
        y = 1;
    }
    if (x = 5) {
        y = 2;
    }
    while y < 10) {
        y++;
    }
    if (y > 5);
        print("y is big");
    x == 10;
    else {
        y = 0;
    }
    return 0;
}
